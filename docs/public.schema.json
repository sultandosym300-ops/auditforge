{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditforge.local/schema/public-v1.json",
  "title": "AuditForge public protocol and episode files",
  "description": "Agent observations contain no truth, provenance or pristine state. Money is integer minor units, FX rates are decimal strings. Extended fields are optional.",
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "generator_version",
        "episode_id",
        "company",
        "base_currency",
        "period_start",
        "period_end",
        "timezone",
        "currency_exponents",
        "rounding",
        "records",
        "documents"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "generator_version": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "base_currency": {
          "type": "string"
        },
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "period_end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        },
        "currency_exponents": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "rounding": {
          "const": "ROUND_HALF_EVEN"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ledger": {
      "type": "object",
      "required": [
        "row_id",
        "timestamp",
        "account",
        "debit_minor",
        "credit_minor",
        "currency",
        "entity_id",
        "invoice_id",
        "payment_id"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "account": {
          "type": "string"
        },
        "debit_minor": {
          "type": "integer"
        },
        "credit_minor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "invoice_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payment_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "invoice": {
      "type": "object",
      "required": [
        "doc_id",
        "invoice_id",
        "entity_id",
        "issued_at",
        "due_at",
        "currency",
        "total_minor",
        "line_items"
      ],
      "properties": {
        "total_minor": {
          "type": "integer"
        },
        "line_items": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "payment": {
      "type": "object",
      "required": [
        "doc_id",
        "payment_id",
        "timestamp",
        "currency",
        "amount_minor",
        "invoice_refs"
      ],
      "properties": {
        "amount_minor": {
          "type": "integer"
        },
        "invoice_refs": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "fx": {
      "type": "object",
      "required": [
        "row_id",
        "date",
        "source_currency",
        "target_currency",
        "rate"
      ],
      "properties": {
        "rate": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "fx_date",
        "period",
        "invoice_recognition",
        "rounding",
        "amount_tolerance_minor",
        "allocation"
      ],
      "properties": {
        "amount_tolerance_minor": {
          "const": 0
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "enum": [
            "list_records",
            "get_record",
            "get_document",
            "calculator",
            "submit"
          ]
        },
        "table": {
          "enum": [
            "ledger",
            "invoices",
            "payments",
            "fx"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "maxLength": 256
        },
        "findings": {
          "$ref": "findings.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "const": "list_records"
              }
            }
          },
          "then": {
            "required": [
              "table"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "get_record"
              }
            }
          },
          "then": {
            "required": [
              "table",
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "get_document"
              }
            }
          },
          "then": {
            "required": [
              "doc_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "calculator"
              }
            }
          },
          "then": {
            "required": [
              "expression"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "submit"
              }
            }
          },
          "then": {
            "required": [
              "findings"
            ]
          }
        }
      ]
    },
    "initial_observation": {
      "type": "object",
      "required": [
        "task",
        "manifest",
        "policy",
        "steps_remaining"
      ],
      "properties": {
        "task": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "steps_remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "trajectory": {
      "type": "object",
      "required": [
        "episode_id",
        "step",
        "action",
        "observation",
        "reward",
        "terminated",
        "truncated"
      ],
      "properties": {
        "episode_id": {
          "type": "string"
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "observation": {
          "type": "object"
        },
        "reward": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "terminated": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
